{
    "manifest_version": 3,
    "name": "Notix",
    "version": "2.2",
    "description": "A Chrome extension that helps in saving temporary notes with real-time sync",
    "author": "Tran Nguyen Thuong Truong",
    "homepage_url": "https://thuongtruong109.github.io/notix",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": ["storage"],
    "action": {
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        },
        "default_title": "Notix - Open Extension Window"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "modules/scripts/settings.js",
                "modules/third-party/domtoimg.js"
            ],
            "matches": ["*://*/*"]
        }
    ],
    "background": {
        "service_worker": "background.js"
    }
}
